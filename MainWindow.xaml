                                    <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,4">
                                        <TextBlock x:Name="StatBatteryPercentText" Text="100%" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" VerticalAlignment="Bottom" />

                                        <Button x:Name="NightModeBtn" Style="{StaticResource IslandIconButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="6,2" Click="NightModeBtn_Click" ToolTip="Sıcak Gece Filtresini Aç / Kapat">
                                            <TextBlock x:Name="NightModeBtnText" Text="🌙 Gece" FontSize="9" Foreground="#FDE047" />
                                        </Button>
                                    </Grid>

                                    <!-- Row 2: Adaptive Brightness Slider Bar (Looks like reference glowing bar + interactive screen brightness!) -->
                                    <Grid Grid.Row="2" Margin="0,0,0,5">
                                        <ProgressBar x:Name="StatBatteryBar" Visibility="Collapsed" />
                                        <Slider x:Name="BrightnessSlider"
                                                Minimum="25" Maximum="100" Value="100"
                                                IsMoveToPointEnabled="True"
                                                ToolTip="Ekran Parlaklığı Kaydırıcısı (%25 - %100)"
                                                ValueChanged="BrightnessSlider_ValueChanged" />
                                    </Grid>

                                    <!-- Row 3: Brightness % & Health Footer -->
                                    <Grid Grid.Row="3">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="☀ Ekran " Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" />
                                            <TextBlock x:Name="BrightnessPercentText" Text="100%" Foreground="#E2E8F0" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="♡ İyi" Foreground="#CBD5E1" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- CARD 5: WEATHER HEADER + WI-FI & BLUETOOTH MINI SUB-CARDS      -->
                            <!-- ============================================================== -->
                            <Border x:Name="StatEnvCardBorder" Grid.Column="8" CornerRadius="20" BorderThickness="1" BorderBrush="#28FFFFFF" Padding="10,8" ClipToBounds="True">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.88,0.18" GradientOrigin="0.88,0.18" RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop x:Name="EnvCardGlowStop" Color="#35F43F5E" Offset="0.0" />
                                        <GradientStop Color="#E60B0E18" Offset="0.75" />
                                        <GradientStop Color="#F2080A12" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Half: Weather City, Temp & Cloud Accent (Click to change city or auto-detect GPS) -->
                                    <Grid Grid.Row="0" Margin="2,1,2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="StatWeatherIconText" Grid.Column="0" Text="🌤️" FontSize="23" VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Normal Display Mode (Click to Edit City) -->
                                            <StackPanel x:Name="WeatherCityDisplayPanel" Cursor="Hand" MouseLeftButtonDown="WeatherCityHeader_MouseLeftButtonDown" ToolTip="Konumu değiştirmek veya GPS ile yenilemek için tıklayın">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="StatWeatherCityText" Text="Konum..." Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="92" />
                                                    <TextBlock Text=" 📍" FontSize="9.5" Opacity="0.65" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="StatWeatherTitle" Text="Güncelleniyor..." Foreground="#94A3B8" FontSize="9.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Inline City Search Box (Shown when user clicks city name) -->
                                            <Grid x:Name="WeatherCityEditPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="WeatherCityInputBox"
                                                         Grid.Column="0"
                                                         Background="#CC080A14"
                                                         Foreground="#FFFFFF"
                                                         BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                                                         BorderThickness="1"
                                                         Padding="5,2"
                                                         FontSize="10.5"
                                                         KeyDown="WeatherCityInputBox_KeyDown"
                                                         ToolTip="Şehir veya ilçe adı yazıp Enter'a basın (Örn: Artvin, Ankara, Kadıköy)" />
                                                <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="✓" Padding="5,2" Margin="3,0,0,0" FontSize="9.5" Click="WeatherCitySave_Click" ToolTip="Şehri Kaydet" />
                                                <Button Grid.Column="2" Style="{StaticResource IslandIconButton}" Content="📍" Padding="4,2" Margin="2,0,0,0" FontSize="9.5" Click="WeatherCityAutoGps_Click" ToolTip="Windows GPS / Wi-Fi ile Otomatik Konum Bul" />
                                            </Grid>
                                        </Grid>

                                        <!-- Decorative Cloud Vector Graphic (Tinted with Adaptive Accent) -->
                                        <Path x:Name="WeatherDecorCloudPath"
                                              Grid.Column="2"
                                              Data="M 18.5,19 L 7,19 C 4.2,19 2,16.8 2,14 C 2,11.4 3.9,9.3 6.4,9 C 7.4,6.1 10.2,4 13.5,4 C 17.6,4 21,7.4 21,11.5 C 22.7,12.1 24,13.7 24,15.5 C 24,17.5 21.5,19 18.5,19 Z"
                                              Fill="#38F43F5E" Width="32" Height="24" Stretch="Uniform" VerticalAlignment="Top" Margin="4,-2,-2,0" />
                                    </Grid>

                                    <!-- Bottom Half: Two Side-by-Side Sub-Cards (Wi-Fi/Speed + Bluetooth) -->
                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.12*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="0.95*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Sub-Card 1: Wi-Fi & Live Download Speed -->
                                        <Border Grid.Column="0" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="7,5.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 2,8.5 C 7.5,4 16.5,4 22,8.5 M 5.5,12.5 C 9.2,9.5 14.8,9.5 18.5,12.5 M 9,16.5 C 10.8,15 13.2,15 15,16.5 M 12,20 L 12.01,20"
                                                          Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="StatNetworkText" Text="Wi-Fi" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="66" />
                                                </StackPanel>

                                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                                    <TextBlock x:Name="StatNetSpeedText" Text="↓ 0 KB/s" Foreground="#94A3B8" FontSize="8.8" FontWeight="Medium" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" MaxWidth="64" />

                                                    <!-- 4-Bar Signal Indicator (Adaptive Accent) -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <Rectangle x:Name="WifiBar1" Width="2.2" Height="4" RadiusX="1" RadiusY="1" Fill="#F43F5E" Margin="0.8,0" VerticalAlignment="Bottom" />
                                                        <Rectangle x:Name="WifiBar2" Width="2.2" Height="6.5" RadiusX="1" RadiusY="1" Fill="#F43F5E" Margin="0.8,0" VerticalAlignment="Bottom" />
                                                        <Rectangle x:Name="WifiBar3" Width="2.2" Height="9" RadiusX="1" RadiusY="1" Fill="#F43F5E" Margin="0.8,0" VerticalAlignment="Bottom" />
                                                        <Rectangle x:Name="WifiBar4" Width="2.2" Height="11.5" RadiusX="1" RadiusY="1" Fill="#F43F5E" Margin="0.8,0,0,0" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Sub-Card 2: Bluetooth -->
                                        <Border Grid.Column="2" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="7,5.5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 6.5,6.5 L 17.5,17.5 L 12,23 L 12,1 L 17.5,6.5 L 6.5,17.5"
                                                          Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="10" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Bluetooth" Foreground="#FFFFFF" FontSize="9.5" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Bottom">
                                                    <TextBlock Text="✦ " Foreground="#64748B" FontSize="8.5" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="StatBluetoothText" Text="Cihaz yok" Foreground="#94A3B8" FontSize="8.8" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="58" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- TAB 3: TIMER (POMODORO) & QUICK NOTES         -->
                        <!-- ============================================== -->
                        <!-- ============================================== -->
                        <!-- TAB 3: TIMER (POMODORO) & QUICK NOTES         -->
                        <!-- ============================================== -->
                        <Grid x:Name="TabTimerView" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Timer / Pomodoro Card with Circular Neon Ring -->
                            <Border x:Name="TimerCardBorder" Grid.Column="0" CornerRadius="20" BorderThickness="1" BorderBrush="#28FFFFFF" Padding="12,10" ClipToBounds="True">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.85,0.85" GradientOrigin="0.85,0.85" RadiusX="0.85" RadiusY="0.85">
                                        <GradientStop x:Name="TimerCardGlowStop" Color="#30F43F5E" Offset="0.0" />
                                        <GradientStop Color="#E60B0E18" Offset="0.75" />
                                        <GradientStop Color="#F2080A12" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Neon Circular Ring Countdown Timer -->
                                    <Grid Grid.Column="0" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Subtle Dark Circular Track -->
                                        <Ellipse Width="84" Height="84" Stroke="#20FFFFFF" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        
                                        <!-- Animated Glowing Neon Arc -->
                                        <Path x:Name="TimerRingArcPath" Stroke="{DynamicResource DynamicAccentBorderBrush}" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <!-- Center Digital Timer & Label -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TimerTagText" Text="ODAKLAN" Foreground="{DynamicResource DynamicAccentBorderBrush}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                            <TextBlock x:Name="TimerDisplay" Text="25:00" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="TimerStateText" Text="✦ Çalışma" Foreground="#94A3B8" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Right: Presets & Glass Control Buttons -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <!-- 4 Quick Preset Buttons in 2x2 Grid -->
                                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,8">
                                            <Button Style="{StaticResource IslandIconButton}" Content="25 Dk" Padding="4,2.5" Margin="2" Click="TimerPreset_Click" Tag="25" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="10 Dk" Padding="4,2.5" Margin="2" Click="TimerPreset_Click" Tag="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="5 Dk" Padding="4,2.5" Margin="2" Click="TimerPreset_Click" Tag="5" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="1 Dk" Padding="4,2.5" Margin="2" Click="TimerPreset_Click" Tag="1" />
                                        </UniformGrid>

                                        <!-- Start / Pause & Reset Action Buttons -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="TimerStartPauseBtn" Grid.Column="0" Style="{StaticResource IslandIconButton}" Background="{DynamicResource DynamicPlayFillBrush}" BorderBrush="{DynamicResource DynamicAccentBorderBrush}" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,5" Margin="0,0,4,0" Click="TimerStartPause_Click">
                                                <TextBlock x:Name="TimerBtnLabel" Text="▶ Başlat" FontSize="11" />
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="↺" Padding="8,5" Click="TimerReset_Click" ToolTip="Sayacı Sıfırla" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Quick Notes Column Card -->
                            <Border x:Name="NotesCardBorder" Grid.Column="2" CornerRadius="20" BorderThickness="1" BorderBrush="#28FFFFFF" Padding="12,10" ClipToBounds="True">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.85,0.85" GradientOrigin="0.85,0.85" RadiusX="0.85" RadiusY="0.85">
                                        <GradientStop x:Name="NotesCardGlowStop" Color="#30EC4899" Offset="0.0" />
                                        <GradientStop Color="#E60B0E18" Offset="0.75" />
                                        <GradientStop Color="#F2080A12" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Notes Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 14,2 L 6,2 C 4.9,2 4,2.9 4,4 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,8 L 14,2 Z M 13,3.5 L 18.5,9 L 13,9 L 13,3.5 Z M 8,12 L 16,12 M 8,16 L 14,16"
                                                  Stroke="#F472B6" StrokeThickness="1.5" Width="12" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Hızlı Not Defteri" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="✦ Otomatik Kayıt" Foreground="{DynamicResource DynamicAccentBorderBrush}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Notes Text Area -->
                                    <Border Grid.Row="1" Background="#CC0D101C" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="14" Padding="4">
                                        <TextBox x:Name="QuickNoteTextBox"
                                                 Background="Transparent"
                                                 Foreground="#F1F5F9"
                                                 BorderThickness="0"
                                                 Padding="6,4"
                                                 FontSize="11"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="QuickNoteTextBox_TextChanged" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- TAB 4: QUICK DOCK LAUNCHER & SETTINGS         -->
                        <!-- ============================================== -->
                        <Grid x:Name="TabDockView" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.28*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Mini App Dock Card -->
                            <Border x:Name="DockCardBorder" Grid.Column="0" CornerRadius="20" BorderThickness="1" BorderBrush="#28FFFFFF" Padding="12,10" ClipToBounds="True"
                                    AllowDrop="True"
                                    Drop="Dock_Drop"
                                    DragOver="FileTray_DragOver">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.85,0.85" GradientOrigin="0.85,0.85" RadiusX="0.85" RadiusY="0.85">
                                        <GradientStop x:Name="DockCardGlowStop" Color="#30F43F5E" Offset="0.0" />
                                        <GradientStop Color="#E60B0E18" Offset="0.75" />
                                        <GradientStop Color="#F2080A12" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Dock Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M 4.5,16.5 C 3,18 3,21 3,21 C 3,21 6,21 7.5,19.5 C 8.3,18.7 8.3,17.3 7.5,16.5 C 6.7,15.7 5.3,15.7 4.5,16.5 Z M 14.5,4 C 18,3 21,3 21,3 C 21,3 21,6 20,9.5 L 13,16.5 L 7.5,11 Z"
                                                  Stroke="#FB7185" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Hızlı Başlatıcı (Mini Dock)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Style="{StaticResource IslandIconButton}" Padding="7,2.5" HorizontalAlignment="Right" Click="SnapToggle_Click" ToolTip="Pencereleri ekranın sağına/soluna/ortasına hizalayın (Snap)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🪟" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Pencere Hizala" FontSize="9.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="DockAppsPanel" Orientation="Horizontal" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Right: Settings & Toggles Card -->
                            <Border x:Name="SettingsCardBorder" Grid.Column="2" CornerRadius="20" BorderThickness="1" BorderBrush="#28FFFFFF" Padding="12,10" ClipToBounds="True">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.85,0.85" GradientOrigin="0.85,0.85" RadiusX="0.85" RadiusY="0.85">
                                        <GradientStop x:Name="SettingsCardGlowStop" Color="#30EC4899" Offset="0.0" />
                                        <GradientStop Color="#E60B0E18" Offset="0.75" />
                                        <GradientStop Color="#F2080A12" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Settings Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7" VerticalAlignment="Center">
                                        <Path Data="M 12,15 C 10.3,15 9,13.7 9,12 C 9,10.3 10.3,9 12,9 C 13.7,9 15,10.3 15,12 C 15,13.7 13.7,15 12,15 Z M 19.4,13 C 19.5,12.7 19.5,12.3 19.5,12 C 19.5,11.7 19.5,11.3 19.4,11 L 21.5,9.3 C 21.7,9.1 21.8,8.9 21.6,8.6 L 19.6,5.1 C 19.5,4.9 19.2,4.8 19,4.9 L 16.5,5.9 C 16,5.5 15.4,5.2 14.8,4.9 L 14.4,2.3 C 14.4,2 14.2,1.8 13.9,1.8 L 10.1,1.8 C 9.8,1.8 9.6,2 9.6,2.3 L 9.2,4.9 C 8.6,5.2 8,5.5 7.5,5.9 L 5,4.9 C 4.8,4.8 4.5,4.9 4.4,5.1 L 2.4,8.6 C 2.2,8.9 2.3,9.1 2.5,9.3 L 4.6,11 C 4.5,11.3 4.5,11.7 4.5,12 C 4.5,12.3 4.5,12.7 4.6,13 L 2.5,14.7 C 2.3,14.9 2.2,15.1 2.4,15.4 L 4.4,18.9 C 4.5,19.1 4.8,19.2 5,19.1 L 7.5,18.1 C 8,18.5 8.6,18.8 9.2,19.1 L 9.6,21.7 C 9.6,22 9.8,22.2 10.1,22.2 L 13.9,22.2 C 14.2,22.2 14.4,22 14.4,21.7 L 14.8,19.1 C 15.4,18.8 16,18.5 16.5,18.1 L 19,19.1 C 19.2,19.2 19.5,19.1 19.6,18.9 L 21.6,15.4 C 21.8,15.1 21.7,14.9 21.5,14.7 L 19.4,13 Z"
                                              Stroke="#F472B6" StrokeThickness="1.5" Width="12" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Ada &amp; Oyun Ayarları" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Settings Action & Toggle Buttons -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <Button x:Name="GameModeToggleBtn" Style="{StaticResource IslandIconButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,3.5" Click="GameModeToggle_Click" ToolTip="Tam ekran oyun veya film açıkken adayı otomatik uyku moduna alır">
                                            <TextBlock x:Name="GameModeToggleText" Text="🎮 Oyun/Film Oto-Uyku: Açık" FontSize="10" Foreground="#38BDF8" FontWeight="Medium" />
                                        </Button>

                                        <Button x:Name="SoundToggleBtn" Style="{StaticResource IslandIconButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,3.5" Click="SoundToggle_Click" ToolTip="Bildirim ses temasını değiştirmek için tıklayın (iOS Dinamik Ada, Su Damlası, Kristal Melodi, Windows 11, Sessiz)">
                                            <TextBlock x:Name="SoundToggleText" Text="🔊 Ses: 🍎 iOS Dinamik Ada" FontSize="10" FontWeight="Medium" />
                                        </Button>

                                        <Button x:Name="StartupToggleBtn" Style="{StaticResource IslandIconButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,3.5" Click="StartupToggle_Click" ToolTip="Windows açıldığında dinamik adayı otomatik başlat">
                                            <TextBlock x:Name="StartupToggleText" Text="🚀 Başlangıçta Aç: Kapalı" FontSize="10" FontWeight="Medium" />
                                        </Button>

                                        <Button x:Name="SnapSettingsBtn" Style="{StaticResource IslandIconButton}" HorizontalContentAlignment="Left" Padding="8,3.5" Click="SnapToggle_Click" ToolTip="Pencereleri ekranın sağına/soluna/ortasına hizalayın (Snap)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🪟" FontSize="9.5" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Pencere Düzenleyici (Snap)" FontSize="10" FontWeight="Medium" Foreground="#A7F3D0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- 3. OVERLAYS (Volume Scroll & Live Toast / Charging Banner)     -->
                <!-- ============================================================== -->
                <Border x:Name="QuickVolOverlay"
                        Background="#E8090A10"
                        CornerRadius="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="QuickVolText" Text="🔊 Ses: %60" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                        <ProgressBar x:Name="QuickVolBar" Width="100" Height="6" Minimum="0" Maximum="100" Value="60" Foreground="#6C63FF" Background="#22FFFFFF" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Live Notification / Charging Toast Banner -->
                <Border x:Name="ToastBannerOverlay"
                        Background="#F20B0D16"
                        CornerRadius="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastIconText" Text="⚡" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastTitleText" Text="Şarj Ediliyor" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastMessageText" Text="%85" Foreground="#00E5A3" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    </StackPanel>
                </Border>

                <!-- ============================================================== -->
                <!-- 4. SPOTLIGHT QUICK SEARCH & CALCULATOR OVERLAY                 -->
                <!-- ============================================================== -->
                <Border x:Name="SpotlightOverlay"
                        Background="#F5070912"
                        CornerRadius="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                        BorderThickness="1.2"
                        Padding="14,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Bar Header with Icon, InputBox, and Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />

                            <TextBox x:Name="SpotlightInputBox"
                                     Grid.Column="1"
                                     Background="#1AFFFFFF"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     BorderBrush="#35FFFFFF"
                                     BorderThickness="1"
                                     Padding="9,5"
                                     FontSize="12"
                                     FontWeight="Medium"
                                     VerticalAlignment="Center"
                                     KeyDown="SpotlightInputBox_KeyDown"
                                     TextChanged="SpotlightInputBox_TextChanged" />

                            <Button Grid.Column="2" Style="{StaticResource IslandIconButton}" Content="✕" Padding="8,4" Margin="6,0,0,0" FontSize="11" Click="SpotlightClose_Click" ToolTip="Aramayı Kapat (Esc)" />
                        </Grid>

                        <!-- Search Results List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SpotlightResultsPanel">
                                <!-- Default Hint -->
                                <Border x:Name="SpotlightDefaultHint" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Background="#0CFFFFFF" Margin="0,2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="✦ Hızlı Arama &amp; Hesap Makinesi" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                        <TextBlock Text="Uygulama adı yazın (Chrome, Spotify), matematik işlemi yapın (150 * 1.20)&#x0a;veya doğrudan web'de arayın." Foreground="#94A3B8" FontSize="10" TextAlignment="Center" LineHeight="14" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ============================================================== -->
                <!-- 5. LYRICS (CANLI ŞARKI SÖZLERİ & KARAOKE) OVERLAY              -->
                <!-- ============================================================== -->
                <Border x:Name="LyricsOverlay"
                        Grid.RowSpan="2"
                        Background="#F5070912"
                        CornerRadius="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                        BorderThickness="1.2"
                        Padding="14,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Song Title + Artist + Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎤 " FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock x:Name="LyricsOverlayTitle" Text="Şarkı Sözleri" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LyricsOverlayArtist" Text=" • Sanatçı" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="✕" Padding="8,4" FontSize="11" Click="LyricsClose_Click" ToolTip="Şarkı Sözlerini Kapat" />
                        </Grid>

                        <!-- Lyrics Scroll Content -->
                        <ScrollViewer x:Name="LyricsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LyricsLinesPanel" Margin="4,2">
                                <TextBlock x:Name="LyricsStatusHint" Text="Şarkı sözleri aranıyor..." Foreground="#94A3B8" FontSize="11.5" HorizontalAlignment="Center" Margin="0,24,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ============================================================== -->
                <!-- 5.5 ONEE AVATAR LAB CONTROL PANEL OVERLAY                      -->
                <!-- ============================================================== -->
                <Border x:Name="AvatarOverlay"
                        Grid.RowSpan="2"
                        Background="#F5070912"
                        CornerRadius="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                        BorderThickness="1.2"
                        Padding="14,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Title + Status + Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👾 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Onee Avatar Lab" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="AvatarCurrentAnimLabel" Text=" • idle" Foreground="{DynamicResource DynamicAccentBorderBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock Text=" (Dinamik Adaya Entegre)" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="✕" Padding="8,4" FontSize="11" Click="AvatarClose_Click" ToolTip="Avatar Panelini Kapat (Esc)" />
                        </Grid>

                        <!-- Content Grid: Left Big Interactive Avatar Preview, Right Emotion Selector Buttons -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Big Avatar Host Preview Frame (Pure Vector WPF) -->
                            <Border Grid.Column="0"
                                    CornerRadius="18"
                                    Background="#0E121D"
                                    BorderBrush="{DynamicResource DynamicAccentSoftBrush}"
                                    BorderThickness="1.2"
                                    Padding="6"
                                    ClipToBounds="True">
                                <Grid>
                                    <Viewbox Width="118" Height="118" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="300" Height="300">
                                            <Canvas.RenderTransform>
                                                <TranslateTransform X="150" Y="150" />
                                            </Canvas.RenderTransform>
                                            <!-- Head Base Path -->
                                            <Path x:Name="LargeAvatarHeadPath" Fill="{DynamicResource DynamicAvatarBodyBrush}" />
                                            <!-- Left Eye Path -->
                                            <Path x:Name="LargeAvatarLeftEyePath" Fill="#111316" />
                                            <!-- Right Eye Path -->
                                            <Path x:Name="LargeAvatarRightEyePath" Fill="#111316" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- Animation & Emotion Grid Selection Buttons -->
                            <Border Grid.Column="2"
                                    CornerRadius="18"
                                    Background="#0A0D16"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Hazır Duygular &amp; Animasyonlar (Tıklayın):" Foreground="#94A3B8" FontSize="9.5" FontWeight="SemiBold" Margin="2,0,0,5" />

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="AvatarEmotionsPanel">
                                            <!-- Standard procedural preset buttons -->
                                            <Button Style="{StaticResource IslandIconButton}" Content="✨ idle" Tag="idle" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🤔 thinking" Tag="thinking" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😊 happy" Tag="happy" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🎉 excited" Tag="excited" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😲 surprised" Tag="surprised" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🤨 confused" Tag="confused" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🥱 bored" Tag="bored" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😡 angry" Tag="angry" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😴 drowsy" Tag="drowsy" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🧐 curious" Tag="curious" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😎 proud" Tag="proud" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😳 shy" Tag="shy" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🔍 searching" Tag="searching" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="💼 working" Tag="working" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="👂 listening" Tag="listening" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="🎈 celebrate" Tag="celebrate" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="😆 laughing" Tag="laughing" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                            <Button Style="{StaticResource IslandIconButton}" Content="💤 sleeping" Tag="sleeping" Click="AvatarEmotionButton_Click" Margin="2" Padding="7,3.5" FontSize="10" />
                                        </WrapPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============================================================== -->
                <!-- 6. WINDOW SNAP PILL / AKILLI PENCERE DÜZENLEYİCİ OVERLAY       -->
                <!-- ============================================================== -->
                <Border x:Name="SnapOverlay"
                        Grid.RowSpan="2"
                        Background="#F5070912"
                        CornerRadius="24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                        BorderThickness="1.2"
                        Padding="14,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Window Title & Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🪟 " FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Pencereyi Hizala: " Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="SnapTargetWindowTitle" Text="Aktif Pencere" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="✕" Padding="8,4" FontSize="11" Click="SnapClose_Click" ToolTip="Kapat (Esc)" />
                        </Grid>

                        <!-- 6 Snap Tiles Grid -->
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Left Half (50%) -->
                            <Button Grid.Column="0" Style="{StaticResource MinimalGhostButton}" Click="SnapLeftHalf_Click" ToolTip="Sol Yarım (%50)" Padding="0">
                                <Border Background="#16FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,10" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="◧" FontSize="20" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="Sol 50%" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Ekranın Solu" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- 2. Right Half (50%) -->
                            <Button Grid.Column="2" Style="{StaticResource MinimalGhostButton}" Click="SnapRightHalf_Click" ToolTip="Sağ Yarım (%50)" Padding="0">
                                <Border Background="#16FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,10" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="◨" FontSize="20" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="Sağ 50%" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Ekranın Sağı" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- 3. Left Third (1/3) -->
                            <Button Grid.Column="4" Style="{StaticResource MinimalGhostButton}" Click="SnapLeftThird_Click" ToolTip="Sol 1/3 (Belge/Sohbet)" Padding="0">
                                <Border Background="#16FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,10" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▎▌" FontSize="18" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,2,0,4" />
                                        <TextBlock Text="Sol 1/3" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Dar Panel" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- 4. Right Two Thirds (2/3) -->
                            <Button Grid.Column="6" Style="{StaticResource MinimalGhostButton}" Click="SnapRightTwoThirds_Click" ToolTip="Sağ 2/3 (Ana Çalışma)" Padding="0">
                                <Border Background="#16FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,10" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▌▎" FontSize="18" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,2,0,4" />
                                        <TextBlock Text="Sağ 2/3" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Geniş Panel" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- 5. Center Float (72%) -->
                            <Button Grid.Column="8" Style="{StaticResource MinimalGhostButton}" Click="SnapCenterFloat_Click" ToolTip="Merkez Odak (%72)" Padding="0">
                                <Border Background="#16FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,10" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🗗" FontSize="19" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,1,0,4" />
                                        <TextBlock Text="Merkez" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Odak Modu" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- 6. Maximize (100%) -->
                            <Button Grid.Column="10" Style="{StaticResource MinimalGhostButton}" Click="SnapMaximize_Click" ToolTip="Tam Ekran (%100)" Padding="0">
                                <Border Background="#16FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,10" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🗖" FontSize="19" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,1,0,4" />
                                        <TextBlock Text="Tam Ekran" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Kapla" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>

        <!-- ============================================================== -->
        <!-- AVATAR MINI MODE SPEECH BUBBLE (Comic / Glass Pop-up on Left)   -->
        <!-- ============================================================== -->
        <Grid x:Name="AvatarMiniSpeechBubble"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,0,0,0"
              Visibility="Collapsed"
              Opacity="0"
              IsHitTestVisible="False"
              RenderTransformOrigin="1.0,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SpeechBubbleScale" ScaleX="0.2" ScaleY="0.2" />
                    <TranslateTransform x:Name="SpeechBubbleTranslate" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid>
                <!-- Tail pointing right toward the avatar -->
                <Polygon x:Name="SpeechBubbleTail"
                         Points="0,12 8,18 0,24"
                         Fill="#F20D121D"
                         Stroke="{DynamicResource DynamicAccentBorderBrush}"
                         StrokeThickness="1.2"
                         HorizontalAlignment="Right"
                         Margin="0,0,-6,0"
                         VerticalAlignment="Center" />

                <!-- Speech Bubble Body -->
                <Border Background="#F20D121D"
                        BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                        BorderThickness="1.3"
                        CornerRadius="16"
                        Padding="11,6,13,6"
                        MaxWidth="240">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SpeechBubbleIcon" Text="🎵" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SpeechBubbleText"
                                   Text="Şarkı Adı — Sanatçı"
                                   Foreground="#FFFFFF"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="190"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- AVATAR MINI MODE RADIAL QUICK CONTROLS (Long-Press Arc Menu)    -->
        <!-- ============================================================== -->
        <Canvas x:Name="AvatarMiniRadialCanvas"
                Width="58" Height="58"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,0,0,0"
                Visibility="Collapsed"
                Opacity="0"
                ClipToBounds="False">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RadialControlsScale" ScaleX="0.5" ScaleY="0.5" CenterX="29" CenterY="29" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 1. Play / Pause Button (Top-Left, ~135°) -->
            <Button x:Name="RadialBtnPlayPause"
                    Canvas.Left="-44" Canvas.Top="-10"
                    Width="32" Height="32"
                    Style="{StaticResource MinimalGhostButton}"
                    Click="MiniRadialPlayPause_Click"
                    ToolTip="Müziği Oynat / Duraklat"
                    Cursor="Hand">
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="#F50D111A" BorderBrush="{DynamicResource DynamicAccentBorderBrush}" BorderThickness="1.3">
                    <TextBlock x:Name="RadialPlayPauseIcon" Text="⏯️" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>

            <!-- 2. Next Track Button (Left, ~180°) -->
            <Button x:Name="RadialBtnNext"
                    Canvas.Left="-54" Canvas.Top="24"
                    Width="32" Height="32"
                    Style="{StaticResource MinimalGhostButton}"
                    Click="MiniRadialNext_Click"
                    ToolTip="Sonraki Şarkı"
                    Cursor="Hand">
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="#F50D111A" BorderBrush="{DynamicResource DynamicAccentBorderBrush}" BorderThickness="1.3">
                    <TextBlock Text="⏭️" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>

            <!-- 3. Screenshot Snip Button (Bottom-Left, ~225°) -->
            <Button x:Name="RadialBtnSnip"
                    Canvas.Left="-38" Canvas.Top="58"
                    Width="32" Height="32"
                    Style="{StaticResource MinimalGhostButton}"
                    Click="MiniRadialSnip_Click"
                    ToolTip="Hızlı Ekran Alıntısı"
                    Cursor="Hand">
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="#F50D111A" BorderBrush="{DynamicResource DynamicAccentBorderBrush}" BorderThickness="1.3">
                    <TextBlock Text="📸" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>

            <!-- 4. Quick Volume Button (Bottom, ~270°) -->
            <Button x:Name="RadialBtnVol"
                    Canvas.Left="13" Canvas.Top="66"
                    Width="32" Height="32"
                    Style="{StaticResource MinimalGhostButton}"
                    Click="MiniRadialVol_Click"
                    ToolTip="Ses Düzeyi (+%10 / Döngü)"
