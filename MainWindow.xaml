                                </Button>
                                <Button x:Name="TabBtnTimer" Style="{StaticResource NavTabButton}" Click="TabButton_Click" Tag="3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="TabIconTimer" Data="M 12,21 C 16.4,21 20,17.4 20,13 C 20,8.6 16.4,5 12,5 C 7.6,5 4,8.6 4,13 C 4,17.4 7.6,21 12,21 Z M 12,9 L 12,13 L 14.5,14.5 M 9.5,2 L 14.5,2"
