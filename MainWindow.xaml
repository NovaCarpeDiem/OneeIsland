                <!-- ============================================================== -->
                <!-- 3. AVATAR MINI MODE VIEW (Dedicated Floating Avatar Bubble)    -->
                <!-- ============================================================== -->
                <Grid x:Name="AvatarMiniModeView"
                      Width="58" Height="58"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed"
                      Opacity="0"
                      Cursor="Hand"
                      Background="Transparent"
                      MouseEnter="AvatarMiniMode_MouseEnter"
                      MouseLeave="AvatarMiniMode_MouseLeave"
                      MouseMove="AvatarMiniMode_MouseMove"
                      MouseLeftButtonUp="AvatarMiniMode_MouseLeftButtonUp"
                      MouseRightButtonUp="AvatarMiniMode_MouseRightButtonUp"
                      ToolTip="Onee Avatar • Normal ada moduna dönmek için tıklayın">

                    <!-- Luminous Particle Aura Rays (Matches master reference \ | / burst) -->
                    <Canvas x:Name="AvatarMiniAuraCanvas"
                            Width="58" Height="58"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <!-- Top-Left Ray -->
                        <Line X1="20" Y1="10" X2="14" Y2="3" Stroke="{DynamicResource DynamicAccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <!-- Top-Center Ray -->
                        <Line X1="29" Y1="8" X2="29" Y2="1" Stroke="{DynamicResource DynamicAccentBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <!-- Top-Right Ray -->
                        <Line X1="38" Y1="10" X2="44" Y2="3" Stroke="{DynamicResource DynamicAccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <!-- Subtle Inner Glow / Ripple Ring (matches island aesthetics) -->
                    <Ellipse x:Name="AvatarMiniHalo"
                             Width="52" Height="52"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{DynamicResource DynamicAccentSoftBrush}"
                             Opacity="0.55"
                             IsHitTestVisible="False">
