<Window x:Class="DynamicIslandWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Windows"
        Width="710" Height="228"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        RenderOptions.BitmapScalingMode="LowQuality"
        RenderOptions.EdgeMode="Unspecified">

    <Window.Resources>
        <SolidColorBrush x:Key="DynamicAvatarBodyBrush" Color="#F43F5E" />
        <!-- Adaptive Glassmorphic Card Style inside expanded view -->
        <Style x:Key="StatCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#E20A0D18" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicAccentSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <!-- Modern Flat ScrollBar Style for trays and clipboards -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="PanningMode" Value="Both" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <ScrollContentPresenter />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Width="4"
                                       Opacity="0.4"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Width="710" Height="228" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
        <!-- Main Island Container (Animates Width, Height, CornerRadius at 144Hz without shader stalls) -->
        <Border x:Name="IslandContainer"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0"
                Width="356" Height="42"
                CornerRadius="21"
                BorderThickness="1.3"
                SizeChanged="IslandContainer_SizeChanged"
                MouseEnter="IslandContainer_MouseEnter"
                MouseLeave="IslandContainer_MouseLeave"
                MouseLeftButtonDown="IslandContainer_MouseLeftButtonDown"
                MouseLeftButtonUp="IslandContainer_MouseLeftButtonUp"
                MouseMove="IslandContainer_MouseMove"
                PreviewMouseRightButtonDown="IslandContainer_PreviewMouseRightButtonDown"
                MouseRightButtonUp="IslandContainer_MouseRightButtonUp"
                PreviewMouseWheel="IslandContainer_PreviewMouseWheel"
                AllowDrop="True"
                DragEnter="IslandContainer_DragEnter"
                DragLeave="IslandContainer_DragLeave"
                Drop="IslandContainer_Drop"
                ToolTip="İpucu: Sağa/Sola sürükleyebilirsiniz • Sağ Tık: Avatar Mini Mod"
                RenderTransformOrigin="0.5,0.5"
                ClipToBounds="False">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandContainerScale" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="IslandContainerTranslate" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Background>
                <!-- Deep Obsidian-Glass Background (Coucou & Apple hardware match) -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="IslandBgAccentStop" Color="#FF060811" Offset="0.0" />
                    <GradientStop x:Name="IslandBgMidStop" Color="#FF0A0E1A" Offset="0.55" />
                    <GradientStop Color="#FF060812" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <!-- 360-Degree Luminous Adaptive Liquid Neon Rim Border (Master Panel 1 Aura) -->
                <LinearGradientBrush x:Name="IslandNeonLiquidRimBrush" StartPoint="0,1" EndPoint="1,0">
                    <GradientStop x:Name="IslandBorderAccentStop" Color="#F43F5E" Offset="0.0" />
                    <GradientStop x:Name="IslandBorderMidStop" Color="#8B5CF6" Offset="0.45" />
                    <GradientStop x:Name="IslandBorderTopStop" Color="#06B6D4" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid x:Name="IslandHostGrid" ClipToBounds="False">
                <!-- Left Notch Ear (Hidden in floating island mode) -->
                <Path x:Name="NotchLeftEar" Visibility="Collapsed"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="-16,0,0,0" Width="17" Height="17"
                      Data="M 0,0 C 9.5,0 17,7.5 17,17 L 17,0 Z"
                      Fill="#FA060811"
                      IsHitTestVisible="False">
                    <Path.Effect>
                        <DropShadowEffect x:Name="LeftEarGlowEffect" BlurRadius="0" ShadowDepth="0" Color="Transparent" Opacity="0" />
                    </Path.Effect>
                </Path>
                <Path x:Name="NotchLeftEarRim" Visibility="Collapsed"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="-16,0,0,0" Width="17" Height="17"
                      Data="M 0,0 C 9.5,0 17,7.5 17,17"
                      Stroke="{DynamicResource DynamicAccentSoftBrush}" StrokeThickness="1.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />

                <!-- Right Notch Ear (Hidden in floating island mode) -->
                <Path x:Name="NotchRightEar" Visibility="Collapsed"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,0,-16,0" Width="17" Height="17"
                      Data="M 17,0 C 7.5,0 0,7.5 0,17 L 0,0 Z"
                      Fill="#FA060812"
                      IsHitTestVisible="False">
                    <Path.Effect>
                        <DropShadowEffect x:Name="RightEarGlowEffect" BlurRadius="0" ShadowDepth="0" Color="Transparent" Opacity="0" />
                    </Path.Effect>
                </Path>
                <Path x:Name="NotchRightEarRim" Visibility="Collapsed"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,0,-16,0" Width="17" Height="17"
                      Data="M 17,0 C 7.5,0 0,7.5 0,17"
                      Stroke="{DynamicResource DynamicAccentSoftBrush}" StrokeThickness="1.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />

                <!-- Atmospheric Weather: Rain Drops Falling from Notch Ears -->
                <Canvas x:Name="NotchRainCanvas" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="40">
                    <Border x:Name="RainDropLeft" Width="2" Height="7" CornerRadius="1"
                            Background="#9038BDF8" Canvas.Left="-8" Canvas.Top="8" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="RainDropLeftTranslate" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="RainDropRight" Width="2" Height="7" CornerRadius="1"
                            Background="#9038BDF8" Canvas.Right="-8" Canvas.Top="8" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="RainDropRightTranslate" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Canvas>

                <Grid x:Name="IslandContentGrid">
                    <!-- True Rounded Geometry Clip so NO glow or image ever bleeds outside the island corners -->
                    <Grid.Clip>
                        <RectangleGeometry x:Name="IslandClipGeometry" Rect="0,0,353.4,39.4" RadiusX="19.8" RadiusY="19.8" />
                    </Grid.Clip>

                    <!-- Volumetric Center Stage Spotlight (Hidden in floating island mode) -->
                    <Ellipse x:Name="NotchVolumetricGlow" Visibility="Collapsed"
                             Width="180" Height="140"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,-10,0,0"
                             IsHitTestVisible="False"
                             Opacity="0.85">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop x:Name="StageGlowCoreStop" Color="#80F43F5E" Offset="0.0" />
                                <GradientStop x:Name="StageGlowMidStop" Color="#25F43F5E" Offset="0.45" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <BlurEffect Radius="24" KernelType="Gaussian" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Liquid Color Wave Shimmer (Flows from Left Ear to Right Ear on Song Change) -->
                    <Rectangle x:Name="LiquidColorWave"
                               HorizontalAlignment="Left" VerticalAlignment="Stretch"
                               Width="160"
                               Panel.ZIndex="99"
                               IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush x:Name="LiquidWaveBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                <GradientStop x:Name="WaveStopCore" Color="#C0F43F5E" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="LiquidWaveTranslate" X="-180" />
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- Bezel Volume Indicator Bar (Directly on the bottom rim of the notch) -->
                    <Border x:Name="NotchBottomVolumeBar"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Height="5" Margin="26,0,26,2"
                            CornerRadius="2.5"
                            Background="#28FFFFFF"
                            Panel.ZIndex="100"
                            Visibility="Collapsed" Opacity="0"
                            IsHitTestVisible="False">
                        <Grid>
                            <Border x:Name="NotchBottomVolumeFill"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Width="100" CornerRadius="2.5"
                                    Background="{DynamicResource DynamicAccentBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#E11D48" Opacity="0.85" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>

                <!-- Primary Bottom-Left Adaptive Radial Glow (Clipped to exact CornerRadius) -->
                <Border IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=IslandContainer}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.22,0.95" GradientOrigin="0.22,0.95" RadiusX="0.55" RadiusY="0.82">
                            <GradientStop x:Name="AmbientGlowStop" Color="#38E11D48" Offset="0.0" />
                            <GradientStop x:Name="AmbientGlowMidStop" Color="#14E11D48" Offset="0.55" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Secondary Top-Right Adaptive Radial Glow (Clipped to exact CornerRadius) -->
                <Border IsHitTestVisible="False" CornerRadius="{Binding CornerRadius, ElementName=IslandContainer}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.82,0.12" GradientOrigin="0.82,0.12" RadiusX="0.45" RadiusY="0.68">
                            <GradientStop x:Name="AmbientGlowTopRightStop" Color="#24FB7185" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============================================================== -->
                <!-- 1. COLLAPSED VIEW (Floating Dynamic Island Pill 338x42)         -->
                <!-- ============================================================== -->
                <Grid x:Name="CollapsedView" Width="346" Height="42" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CollapsedViewScale" ScaleX="1.0" ScaleY="1.0" />
                            <TranslateTransform x:Name="CollapsedViewTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Avatar / Circular Album Art / Status Orb -->
                    <StackPanel x:Name="CollapsedLeftPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mini Interactive Onee Avatar (Pure Vector WPF) -->
                        <Border x:Name="MiniAvatarHostBorder"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="#10FFFFFF"
                                BorderBrush="{DynamicResource DynamicAccentSoftBrush}"
                                BorderThickness="1.2"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                ToolTip="Onee Avatar Lab (Tıklayarak Duygu/Animasyon Değiştir)"
                                MouseLeftButtonUp="MiniAvatar_MouseLeftButtonUp"
                                MouseEnter="MiniAvatar_MouseEnter"
                                MouseLeave="MiniAvatar_MouseLeave">
                            <Grid ClipToBounds="True">
                                <Viewbox x:Name="MiniAvatarViewbox" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="NormalIslandAvatarBobTranslate" X="0" Y="0" />
                                            <RotateTransform x:Name="NormalIslandAvatarBobRotate" Angle="0" />
                                        </TransformGroup>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="300" Height="300">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform X="150" Y="150" />
                                        </Canvas.RenderTransform>
                                        <!-- Head Base Path: Adaptive Porcelain 3D Body -->
                                        <Path x:Name="MiniAvatarHeadPath" Fill="{DynamicResource DynamicAvatarBodyBrush}" />
                                        <!-- Left Eye Path with Eye Tracking -->
                                        <Path x:Name="MiniAvatarLeftEyePath" Fill="#111316">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="NormalIslandLeftEyeTrack" X="0" Y="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <!-- Right Eye Path with Eye Tracking -->
                                        <Path x:Name="MiniAvatarRightEyePath" Fill="#111316">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="NormalIslandRightEyeTrack" X="0" Y="0" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- Onee Soft Marshmallow Left Paw -->
                                        <Path x:Name="OneeLeftHand"
                                              Data="M -15,0 C -15,-10 15,-10 15,0 C 15,10 -15,10 -15,0 Z"
                                              Fill="{DynamicResource DynamicAvatarBodyBrush}"
                                              Stroke="#25000000" StrokeThickness="1.2"
                                              Canvas.Left="-46" Canvas.Top="60">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="OneeLeftHandTranslate" X="0" Y="0" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- Onee Soft Marshmallow Right Paw -->
                                        <Path x:Name="OneeRightHand"
                                              Data="M -15,0 C -15,-10 15,-10 15,0 C 15,10 -15,10 -15,0 Z"
                                              Fill="{DynamicResource DynamicAvatarBodyBrush}"
                                              Stroke="#25000000" StrokeThickness="1.2"
                                              Canvas.Left="46" Canvas.Top="60">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="OneeRightHandTranslate" X="0" Y="0" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- Onee Expressive Openable Mouth -->
                                        <Canvas Canvas.Left="0" Canvas.Top="58" IsHitTestVisible="False">
                                            <Canvas.RenderTransform>
                                                <ScaleTransform x:Name="OneeNormalMouthScale" ScaleX="0" ScaleY="0" CenterX="0" CenterY="0" />
                                            </Canvas.RenderTransform>
                                            <Path x:Name="OneeNormalMouth"
                                                  Data="M -14,0 C -14,18 14,18 14,0 C 14,-2 -14,-2 -14,0 Z"
                                                  Fill="#28111A" Stroke="#20000000" StrokeThickness="1" />
                                            <Path x:Name="OneeNormalTongue"
                                                  Data="M -8,7 C -8,16 8,16 8,7 C 8,5 -8,5 -8,7 Z"
                                                  Fill="#FF6584" />
                                        </Canvas>

                                        <!-- Petting Floating Heart Particle -->
                                        <Path x:Name="PetHeartParticle"
                                              Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.28 2,8.5 C 2,5.42 4.42,3 7.5,3 C 9.24,3 10.91,3.81 12,5.09 C 13.09,3.81 14.76,3 16.5,3 C 19.58,3 22,5.42 22,8.5 C 22,12.28 18.6,15.36 13.45,20.04 L 12,21.35 Z"
                                              Fill="#FF2E93"
                                              Width="24" Height="24" Stretch="Uniform"
                                              Canvas.Left="35" Canvas.Top="-65"
                                              Opacity="0" IsHitTestVisible="False">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="PetHeartTranslate" X="0" Y="0" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- Onee Sleep & Thought Badge (...) -->
                                        <Border x:Name="OneeThoughtBadge"
                                                Canvas.Left="-30" Canvas.Top="-112"
                                                Width="60" Height="24" CornerRadius="12"
                                                Background="#E00B0E17"
                                                BorderBrush="{DynamicResource DynamicAccentSoftBrush}"
                                                BorderThickness="1.5"
                                                Visibility="Collapsed" Opacity="0"
                                                IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DynamicAccentBrush}" Margin="2,0" />
                                                <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DynamicAccentBrush}" Margin="2,0" />
                                                <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DynamicAccentBrush}" Margin="2,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- DJ Headphone Accessory (Appears when music is playing) -->
                                        <Canvas x:Name="NormalIslandHeadphones" Opacity="0" IsHitTestVisible="False">
                                            <Path Data="M -94,6 C -94,-96 94,-96 94,6"
                                                  Stroke="#181C26" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path Data="M -78,-26 C -78,-90 78,-90 78,-26"
                                                  Stroke="#0C0E14" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path Data="M -74,-42 C -74,-99 74,-99 74,-42"
                                                  Stroke="{DynamicResource DynamicAccentBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Rectangle Canvas.Left="-100" Canvas.Top="4" Width="8" Height="10" RadiusX="3" RadiusY="3" Fill="#64748B" />
                                            <Border Canvas.Left="-118" Canvas.Top="12" Width="26" Height="48" CornerRadius="13"
                                                    Background="#181C26" BorderBrush="{DynamicResource DynamicAccentBrush}" BorderThickness="2.2">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="12" CenterX="13" CenterY="24" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Border Width="16" Height="36" CornerRadius="8" Background="#0C0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Rectangle Canvas.Left="92" Canvas.Top="4" Width="8" Height="10" RadiusX="3" RadiusY="3" Fill="#64748B" />
                                            <Border Canvas.Left="92" Canvas.Top="12" Width="26" Height="48" CornerRadius="13"
                                                    Background="#181C26" BorderBrush="{DynamicResource DynamicAccentBrush}" BorderThickness="2.2">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="-12" CenterX="13" CenterY="24" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Border Width="16" Height="36" CornerRadius="8" Background="#0C0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Canvas>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Mini Album Thumbnail with Adaptive Ring & True Circular Fill (Zero Corner Bleed) -->
                        <Border x:Name="MiniThumbBorder" Width="28" Height="28" CornerRadius="14" BorderBrush="{DynamicResource DynamicAccentBorderBrush}" BorderThickness="1.3" Margin="0,0,8,0" Visibility="Collapsed">
                            <Grid>
                                <Image x:Name="MiniThumbImage" Visibility="Collapsed" />
                                <Ellipse Width="25.4" Height="25.4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="MiniThumbBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Border>

                        <!-- Idle Adaptive Glowing Orb (Zero-shader halo) -->
                        <Grid x:Name="MiniStatusDot" Width="14" Height="14" Margin="2,0,6,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="MiniStatusDot_Click" ToolTip="Sonraki Sekme Rengine Geç (Tıklayın)">
                            <Ellipse x:Name="MiniStatusHalo" Width="14" Height="14" Fill="#34F43F5E" />
                            <Ellipse x:Name="MiniStatusCore" Width="7" Height="7" Fill="#F43F5E" />
                        </Grid>

                        <!-- Microphone Indicator Removed/Hidden per user request -->
                        <Border x:Name="MiniMicBorder" Visibility="Collapsed" Width="0" Height="0">
                            <StackPanel>
                                <Ellipse x:Name="MiniMicDot" />
                                <TextBlock x:Name="MiniMicText" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Two-Line Song Title & Artist Name (When Playing) OR Clock/Timer (When Idle) -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,5,0">
                        <!-- Dedicated Song Title + Artist Stack -->
                        <StackPanel x:Name="MiniMediaInfoPanel" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="MiniTrackTitleText"
                                       Text="Şarkı Adı"
                                       Foreground="#FFFFFF"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock x:Name="MiniTrackArtistText"
                                       Text="Sanatçı"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Margin="0,-1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>

                        <!-- Idle Clock / Date / Pomodoro Text Container -->
                        <Grid x:Name="CollapsedCenterGrid" VerticalAlignment="Center">
                            <TextBlock x:Name="MiniCenterText"
                                       Text="21:28"
                                       Foreground="#FFFFFF"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </Grid>
                    </Grid>

                    <!-- Right: Animated Equalizer + Status Capsules -->
                    <StackPanel x:Name="CollapsedRightPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Equalizer Animation Bars (Positioned on the right like real Dynamic Island) -->
                        <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal" VerticalAlignment="Center" Height="15" Margin="0,0,6,0" Visibility="Collapsed">
                            <StackPanel.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetName="EqBar1Scale" Storyboard.TargetProperty="ScaleY" From="0.35" To="1.0" Duration="0:0:0.35" />
                                            <DoubleAnimation Storyboard.TargetName="EqBar2Scale" Storyboard.TargetProperty="ScaleY" From="1.0" To="0.40" Duration="0:0:0.42" />
                                            <DoubleAnimation Storyboard.TargetName="EqBar3Scale" Storyboard.TargetProperty="ScaleY" From="0.42" To="0.92" Duration="0:0:0.30" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </StackPanel.Triggers>
                            <Rectangle x:Name="EqBar1" Width="3" Height="14" Fill="#F43F5E" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="EqBar1Scale" ScaleY="0.6" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="EqBar2" Width="3" Height="14" Fill="#FB7185" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="EqBar2Scale" ScaleY="0.9" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="EqBar3" Width="3" Height="14" Fill="#FDA4AF" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,1.0">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="EqBar3Scale" ScaleY="0.7" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>

                        <!-- Mini Live Download Badge (Auto-shown when idle & downloading > 250 KB/s) -->
                        <Border x:Name="MiniNetBorder" Background="#CC0B1120" BorderBrush="{DynamicResource DynamicAccentBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4.5,1.5" Margin="0,0,2.5,0" Visibility="Collapsed">
