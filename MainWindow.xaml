                            <BlurEffect Radius="10" KernelType="Gaussian" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Avatar Character Vector Host (Supports spring bounce, hover pop & rhythm dancing) -->
                    <Grid x:Name="AvatarMiniHost"
                          Width="52" Height="52"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          ClipToBounds="False">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MiniBubbleHostScale" ScaleX="1.0" ScaleY="1.0" />
                                <TranslateTransform x:Name="MiniBubbleHostBobTranslate" X="0" Y="0" />
                                <RotateTransform x:Name="MiniBubbleHostBobRotate" Angle="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Viewbox x:Name="AvatarMiniViewbox"
                                 Width="42" Height="42"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="300" Height="300">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="150" Y="150" />
                                </Canvas.RenderTransform>
                                <!-- Head Base Path: Adaptive Vibrant Color (dynamically adapts to background / media) -->
                                <Path x:Name="MiniBubbleHeadPath" Fill="{DynamicResource DynamicAvatarBodyBrush}" />
                                <!-- Left Eye Path with Interactive Eye Tracking -->
                                <Path x:Name="MiniBubbleLeftEyePath" Fill="#111316">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="LeftEyeTrackTranslate" X="0" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <!-- Right Eye Path with Interactive Eye Tracking -->
                                <Path x:Name="MiniBubbleRightEyePath" Fill="#111316">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="RightEyeTrackTranslate" X="0" Y="0" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Mini Bubble Soft Marshmallow Left Paw -->
                                <Path x:Name="MiniBubbleLeftHand"
                                      Data="M -15,0 C -15,-10 15,-10 15,0 C 15,10 -15,10 -15,0 Z"
                                      Fill="{DynamicResource DynamicAvatarBodyBrush}"
                                      Stroke="#25000000" StrokeThickness="1.2"
                                      Canvas.Left="-46" Canvas.Top="60">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MiniBubbleLeftHandTranslate" X="0" Y="0" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Mini Bubble Soft Marshmallow Right Paw -->
                                <Path x:Name="MiniBubbleRightHand"
                                      Data="M -15,0 C -15,-10 15,-10 15,0 C 15,10 -15,10 -15,0 Z"
                                      Fill="{DynamicResource DynamicAvatarBodyBrush}"
                                      Stroke="#25000000" StrokeThickness="1.2"
                                      Canvas.Left="46" Canvas.Top="60">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MiniBubbleRightHandTranslate" X="0" Y="0" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Mini Bubble Expressive Mouth -->
                                <Canvas Canvas.Left="0" Canvas.Top="58" IsHitTestVisible="False">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform x:Name="MiniBubbleMouthScale" ScaleX="0" ScaleY="0" CenterX="0" CenterY="0" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M -14,0 C -14,18 14,18 14,0 C 14,-2 -14,-2 -14,0 Z"
                                          Fill="#28111A" Stroke="#20000000" StrokeThickness="1" />
                                    <Path Data="M -8,7 C -8,16 8,16 8,7 C 8,5 -8,5 -8,7 Z"
                                          Fill="#FF6584" />
                                </Canvas>

                                <!-- Mini Bubble Pet Heart Particle -->
                                <Path x:Name="MiniBubblePetHeart"
                                      Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.28 2,8.5 C 2,5.42 4.42,3 7.5,3 C 9.24,3 10.91,3.81 12,5.09 C 13.09,3.81 14.76,3 16.5,3 C 19.58,3 22,5.42 22,8.5 C 22,12.28 18.6,15.36 13.45,20.04 L 12,21.35 Z"
                                      Fill="#FF2E93"
                                      Width="24" Height="24" Stretch="Uniform"
                                      Canvas.Left="35" Canvas.Top="-65"
                                      Opacity="0" IsHitTestVisible="False">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="MiniBubblePetHeartTranslate" X="0" Y="0" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Mini Bubble Sleep / Thought Badge -->
                                <Border x:Name="MiniBubbleThoughtBadge"
                                        Canvas.Left="-30" Canvas.Top="-112"
                                        Width="60" Height="24" CornerRadius="12"
                                        Background="#E00B0E17"
                                        BorderBrush="{DynamicResource DynamicAccentSoftBrush}"
                                        BorderThickness="1.5"
                                        Visibility="Collapsed" Opacity="0"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DynamicAccentBrush}" Margin="2,0" />
                                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DynamicAccentBrush}" Margin="2,0" />
                                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DynamicAccentBrush}" Margin="2,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Mini Bubble Atmospheric Night Mood -->
                                <Grid x:Name="MiniBubbleNightSleepIndicator"
                                      Canvas.Left="35" Canvas.Top="-115"
                                      Width="26" Height="26"
                                      Visibility="Collapsed" Opacity="0"
                                      IsHitTestVisible="False">
                                    <TextBlock Text="🌙" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- DJ Headphone Accessory (Appears when music is playing) -->
                                <Canvas x:Name="MiniBubbleHeadphones" Opacity="0" IsHitTestVisible="False">
                                    <!-- Top Headband Outer Arch -->
                                    <Path Data="M -94,6 C -94,-96 94,-96 94,6"
                                          Stroke="#181C26" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <!-- Top Headband Inner Cushion -->
                                    <Path Data="M -78,-26 C -78,-90 78,-90 78,-26"
                                          Stroke="#0C0E14" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <!-- Top Headband Accent Center Stripe -->
                                    <Path Data="M -74,-42 C -74,-99 74,-99 74,-42"
                                          Stroke="{DynamicResource DynamicAccentBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                    <!-- Left Ear Cup Hinge & Swivel -->
                                    <Rectangle Canvas.Left="-100" Canvas.Top="4" Width="8" Height="10" RadiusX="3" RadiusY="3" Fill="#64748B" />
                                    <!-- Left Ear Cup Cushion & Shell -->
                                    <Border Canvas.Left="-118" Canvas.Top="12" Width="26" Height="48" CornerRadius="13"
                                            Background="#181C26" BorderBrush="{DynamicResource DynamicAccentBrush}" BorderThickness="2.2">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="12" CenterX="13" CenterY="24" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border Width="16" Height="36" CornerRadius="8" Background="#0C0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Right Ear Cup Hinge & Swivel -->
                                    <Rectangle Canvas.Left="92" Canvas.Top="4" Width="8" Height="10" RadiusX="3" RadiusY="3" Fill="#64748B" />
                                    <!-- Right Ear Cup Cushion & Shell -->
                                    <Border Canvas.Left="92" Canvas.Top="12" Width="26" Height="48" CornerRadius="13"
                                            Background="#181C26" BorderBrush="{DynamicResource DynamicAccentBrush}" BorderThickness="2.2">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-12" CenterX="13" CenterY="24" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border Width="16" Height="36" CornerRadius="8" Background="#0C0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- Mini Mood / Particle Reaction Badge (Popping emoji / expression mark) -->
                    <Border x:Name="AvatarMiniMoodBadge"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Background="#E6101625"
                            BorderBrush="{DynamicResource DynamicAccentBorderBrush}"
                            BorderThickness="1.2"
                            CornerRadius="9"
                            Padding="3.5,1.5"
                            Opacity="0"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AvatarMiniMoodBadgeScale" ScaleX="0.5" ScaleY="0.5" />
                        </Border.RenderTransform>
                        <TextBlock x:Name="AvatarMiniMoodBadgeText" Text="✨" FontSize="9" Foreground="#FDE047" FontWeight="Bold" />
                    </Border>

                    <!-- Mini Status Pip (Corner status indicator) -->
                    <Ellipse x:Name="AvatarMiniStatusDot"
                             Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,3,3"
                             Fill="#00E5A3"
                             Stroke="#FA060811" StrokeThickness="1.5"
                             Visibility="Collapsed" />

                    <!-- Extension Slot for mini quick controls -->
                    <StackPanel x:Name="AvatarMiniExtensionPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Visibility="Collapsed" />
