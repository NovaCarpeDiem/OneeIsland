                                </Button>
                                <Button x:Name="TabBtnDock" Style="{StaticResource NavTabButton}" Click="TabButton_Click" Tag="4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="TabIconDock" Data="M 4.5,16.5 C 3,18 3,21 3,21 C 3,21 6,21 7.5,19.5 C 8.3,18.7 8.3,17.3 7.5,16.5 C 6.7,15.7 5.3,15.7 4.5,16.5 Z M 14.5,4 C 18,3 21,3 21,3 C 21,3 21,6 20,9.5 L 13,16.5 L 7.5,11 Z"
